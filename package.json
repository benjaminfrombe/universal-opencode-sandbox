{
  "name": "universal-opencode-sandbox",
  "version": "0.1.1",
  "description": "Universal OS-level sandbox for OpenCode agent shell commands on macOS, Linux and Windows, enforced by Microsoft MXC",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir dist --target node --format esm --external @microsoft/mxc-sdk --external @opencode/plugin && bun x tsc -p tsconfig.declarations.json",
    "dev": "bun run --watch src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "sandbox",
    "security",
    "mxc",
    "seatbelt",
    "bubblewrap",
    "processcontainer",
    "agent-safety"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benjaminfrombe/universal-opencode-sandbox.git"
  },
  "homepage": "https://github.com/benjaminfrombe/universal-opencode-sandbox#readme",
  "bugs": {
    "url": "https://github.com/benjaminfrombe/universal-opencode-sandbox/issues"
  },
  "dependencies": {
    "@microsoft/mxc-sdk": "^1.1.0"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.3.0",
    "@types/bun": "^1.3.9",
    "typescript": "^5.9.0"
  }
}
